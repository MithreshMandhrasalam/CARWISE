AI_SERVICE_USE_MOCK=true
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# Model version tracking
DAMAGE_MODEL_VERSION=mock-v0.1
PRICE_MODEL_VERSION=mock-v0.1
