# ═══════════════════════════════════════════════════════════════════════════════
# CARWISE — Root Environment Configuration Example
# ═══════════════════════════════════════════════════════════════════════════════

# Database
MONGO_URI=mongodb://localhost:27017/carwise_db
MONGO_INITDB_DATABASE=carwise_db

# Backend Service
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads

# AI Analytical Microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_USE_MOCK=true
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# Frontend Service
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=CARWISE
