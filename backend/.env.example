PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/carwise_db

# JWT Configuration (Change in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# File Storage Configuration (local in dev, s3 in production)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
